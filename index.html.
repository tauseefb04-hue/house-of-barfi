  <div class="drawer-body" id="drawerBody">
    <p class="drawer-empty">Your box is empty. Add some barfi to get started.</p>
  </div>
  <div class="drawer-foot" id="drawerFoot" style="display:none;">
    <div class="subtotal-row">
      <span>Subtotal</span>
      <span id="subtotalAmount">$0</span>
    </div>
    <button class="checkout-btn" id="checkoutBtn">Continue to checkout</button>
    <p class="checkout-note">Secure checkout via Stripe.</p>
  </div>
</div>

<div class="modal" id="checkoutModal">
  <div class="modal-card">
    <div class="diamond" style="width:56px;height:56px;background:var(--gold);"><span></span></div>
    <h3 id="modalTitle">Something went wrong</h3>
    <p id="modalMessage">We couldn't start checkout just now. Please try again in a moment, or reach out directly to place this order.</p>
    <button class="modal-close-btn" id="modalCloseBtn">Back to shop</button>
  </div>
</div>

<script>
  const products = {
    classic: { name: 'Classic barfi box', price: 18, color: '#E8C9A8' },
    mix: { name: 'Mithai mix box', price: 20, color: '#7C9463' },
    mixBarfi: { name: 'Mix barfi box', price: 19, color: '#D9BE97' },
    sixteenPcMix: { name: 'Signature 16pc Mix', price: 28, color: '#C99A3D' },
    ninePcMix: { name: 'Signature 9pc Mix', price: 17.5, color: '#E4C077' },
    tenPcMixedBarfee: { name: '10 pc. Mixed Barfee Box', price: 17, color: '#D9BE97' },
    khoyaBarfee: { name: 'Khoya Barfee', price: 17, color: '#E8C9A8' },
    almondBarfee: { name: 'Almond Barfee', price: 17, color: '#D9BE97' },
    pistaBarfee: { name: 'Pista Barfee', price: 17, color: '#7C9463' },
    coffeeBarfee: { name: 'Coffee Barfee', price: 17, color: '#8A5A3C' },
    mangoBarfee: { name: 'Mango Barfee', price: 17, color: '#E8A94B' },
    besanBarfee: { name: 'Besan Barfee', price: 16, color: '#C99A3D' },
    kalakand: { name: 'Kalakand', price: 16, color: '#F0E6CE' },
    coconutKalakand: { name: 'Pink Coconut Kalakand', price: 16, color: '#C97B85' },
    chocoKalakand: { name: 'Chocolate Coated Kalakand', price: 16, color: '#5B3A29' },
    kajuKatli: { name: 'Kaju Katli', price: 18, color: '#E4C077' },
    motichoorLaddoo: { name: 'Motichoor Laddoo', price: 15, color: '#E4C077' },
    balushahi: { name: 'BaluShahi', price: 11, color: '#C99A3D' },
    habshiHalwa: { name: 'Habshi Halwa', price: 17, color: '#8A5A3C' },
    patisa: { name: 'Patisa', price: 16, color: '#E8C9A8' },
    gulabJamun: { name: 'Gulab Jamun', price: 16, color: '#5B1B2E' },
    kalaJamun: { name: 'Kala Jamun', price: 16, color: '#431422' },
    kheerMohan: { name: 'Kheer Mohan', price: 13, color: '#E4C077' },
    coconutJamun2: { name: 'Coconut Jamun', price: 13, color: '#F0E6CE' },
    milkCake: { name: 'Milk Cake', price: 18, color: '#EFE4CC' },
    sohanHalwa: { name: 'Sohan Halwa', price: 17, color: '#C99A3D' },
    chamCham2: { name: 'Cham Cham', price: 18, color: '#C97B85' },
    rusgulla: { name: 'Rusgulla', price: 16, color: '#F6EEDD' },
    coconutCutlets: { name: 'Coconut Cutlets', price: 13, color: '#EFE4CC' },
    goldenTray: { name: 'Mixed Mithai Golden Tray', price: 55, color: '#C99A3D' },
    goldBox3lb: { name: '3 Lb Gold Box Mixed Mithai', price: 44, color: '#E4C077' },
  };

  const cart = {};

  const trayColors = ['#E8C9A8', '#7C9463', '#C97B85', '#C99A3D', '#5B1B2E'];
  const tray = document.getElementById('heroTray');
  const positions = [
    {top:'6%', left:'8%'}, {top:'2%', left:'42%'}, {top:'18%', left:'70%'},
    {top:'40%', left:'20%'}, {top:'36%', left:'56%'}, {top:'58%', left:'4%'},
    {top:'62%', left:'40%'}, {top:'52%', left:'76%'}, {top:'80%', left:'18%'},
    {top:'78%', left:'58%'}
  ];
  positions.forEach((pos, i) => {
    const d = document.createElement('div');
    d.className = 'diamond';
    d.style.top = pos.top;
    d.style.left = pos.left;
    d.style.background = trayColors[i % trayColors.length];
    d.style.animationDelay = (i * 0.06) + 's';
    const inner = document.createElement('span');
    d.appendChild(inner);
    tray.appendChild(d);
  });

  document.querySelectorAll('.qty-stepper').forEach(stepper => {
    const input = stepper.querySelector('input');
    stepper.querySelector('[data-action="inc"]').addEventListener('click', () => {
      input.value = Math.min(99, parseInt(input.value, 10) + 1);
    });
    stepper.querySelector('[data-action="dec"]').addEventListener('click', () => {
      input.value = Math.max(1, parseInt(input.value, 10) - 1);
    });
  });

  document.querySelectorAll('[data-add]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-add');
      const stepper = document.querySelector(`[data-qty-for="${id}"] input`);
      const qty = parseInt(stepper.value, 10);
      if (!cart[id]) cart[id] = 0;
      cart[id] += qty;
      stepper.value = 1;
      renderCart();
      openDrawer();
    });
  });

  function formatUSD(n) {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function renderCart() {
    const body = document.getElementById('drawerBody');
    const foot = document.getElementById('drawerFoot');
    const countEl = document.getElementById('cartCount');
    const ids = Object.keys(cart).filter(id => cart[id] > 0);

    let totalCount = 0;
    let subtotal = 0;
    ids.forEach(id => { totalCount += cart[id]; subtotal += cart[id] * products[id].price; });
    countEl.textContent = totalCount;

    if (ids.length === 0) {
      body.innerHTML = '<p class="drawer-empty">Your box is empty. Add some barfi to get started.</p>';
      foot.style.display = 'none';
      return;
    }

    foot.style.display = 'block';
    document.getElementById('subtotalAmount').textContent = formatUSD(subtotal);

    body.innerHTML = '';
    ids.forEach(id => {
      const p = products[id];
      const line = document.createElement('div');
      line.className = 'cart-line';
      line.innerHTML = `
        <div class="swatch" style="background:${p.color};"></div>
        <div class="cart-line-info">
          <div class="name">${p.name}</div>
          <div class="price">${formatUSD(p.price)} × ${cart[id]} = ${formatUSD(p.price * cart[id])}</div>
          <button class="cart-line-remove" data-remove="${id}">Remove</button>
        </div>
      `;
      body.appendChild(line);
    });

    body.querySelectorAll('[data-remove]').forEach(rbtn => {
      rbtn.addEventListener('click', () => {
        delete cart[rbtn.getAttribute('data-remove')];
        renderCart();
      });
    });
  }

  const drawer = document.getElementById('drawer');
  const overlay = document.getElementById('overlay');

  function openDrawer() {
    drawer.classList.add('open');
    overlay.classList.add('open');
  }
  function closeDrawer() {
    drawer.classList.remove('open');
    overlay.classList.remove('open');
  }

  document.getElementById('cartOpenBtn').addEventListener('click', openDrawer);
  document.getElementById('drawerCloseBtn').addEventListener('click', closeDrawer);
  overlay.addEventListener('click', () => { closeDrawer(); closeModal(); });

  const modal = document.getElementById('checkoutModal');
  function openModal(title, message) {
    if (title) document.getElementById('modalTitle').textContent = title;
    if (message) document.getElementById('modalMessage').textContent = message;
    modal.classList.add('open');
  }
  function closeModal() { modal.classList.remove('open'); }

  document.getElementById('checkoutBtn').addEventListener('click', async () => {
    const ids = Object.keys(cart).filter(id => cart[id] > 0);
    if (ids.length === 0) return;

    const checkoutBtn = document.getElementById('checkoutBtn');
    const originalText = checkoutBtn.textContent;
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'Redirecting to checkout…';

    const items = ids.map(id => ({
      name: products[id].name,
      price: products[id].price,
      quantity: cart[id]
    }));

    try {
      const res = await fetch('/.netlify/functions/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
      });

      if (!res.ok) throw new Error('Checkout session failed');
      const data = await res.json();

      if (data.url) {
        window.location.href = data.url;
      } else {
        throw new Error('No checkout URL returned');
      }
    } catch (err) {
      closeDrawer();
      openModal('Something went wrong', "We couldn't start checkout just now. Please try again in a moment, or reach out directly to place this order.");
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = originalText;
    }
  });
  document.getElementById('modalCloseBtn').addEventListener('click', closeModal);

  // Show a message if returning from Stripe checkout
  (function handleCheckoutReturn() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('success') === 'true') {
      openModal('Thank you for your order!', "Your payment went through — we'll be in touch shortly to confirm details. A receipt has been sent to your email.");
      window.history.replaceState({}, document.title, window.location.pathname);
    } else if (params.get('canceled') === 'true') {
      openModal('Checkout canceled', "No charge was made. Your box is still saved if you'd like to try again.");
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  })();
</script>

</body>
</html>
